# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files

# =========================
# Frontend: Angular / React
# =========================

# Compiled output
/dist/
/tmp/
/out-tsc/
/bazel-out/
/build/

# Node.js dependencies
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Frontend environment files
.env
.env.*
!.env.example
!.env.sample

# Angular
/.angular/cache/
/.sass-cache/

# =========================
# Backend: Python / FastAPI
# =========================

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Python build and packaging
build/
dist/
wheels/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
venv/
.venv/
env/
ENV/
venv-*/
.venv-*/

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Python test and coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
nosetests.xml
test-results/

# Type checking and linting
.mypy_cache/
.pyright/
.ruff_cache/
.dmypy.json
dmypy.json

# Jupyter notebooks
.ipynb_checkpoints/

# FastAPI / ASGI local runtime files
*.pid
*.sock

# Logs
*.log
logs/

# Local databases
*.sqlite3
*.db

# Uploads and generated local files
media/
uploads/
generated/
storage/

# =========================
# IDEs and editors
# =========================

.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# =========================
# Miscellaneous
# =========================

/coverage/
/libpeerconnection.log
testem.log
/typings/
connect.lock

# System files
.DS_Store
Thumbs.db
desktop.ini

# =========================
# Docker / local development
# =========================

# Local overrides; keep shared compose files tracked
docker-compose.override.yml
compose.override.yaml
compose.override.yml

# =========================
# Optional: generated frontend assets
# =========================

*.tsbuildinfo
